<?xml version="1.0" encoding="UTF-8"?>
<!--
Info.plist – Berechtigungsschlüssel für LehrerAgent iOS App
Diese Einträge müssen in das Info.plist des Xcode-Projekts eingefügt werden.
In Xcode: Target → Info → Custom iOS Target Properties
-->

<!--
REQUIRED: Kamera-Berechtigung
-->
<key>NSCameraUsageDescription</key>
<string>LehrerAgent benötigt Kamerazugriff, um Schülerarbeiten zu fotografieren und auszuwerten.</string>

<!--
REQUIRED: Fotogalerie lesen (PHPickerViewController)
-->
<key>NSPhotoLibraryUsageDescription</key>
<string>LehrerAgent kann Fotos von Schülerarbeiten aus deiner Galerie laden und auswerten.</string>

<!--
REQUIRED: Lokales Netzwerk (für WebSocket im WLAN)
Ohne diesen Eintrag blockiert iOS die Verbindung zum Mac.
-->
<key>NSLocalNetworkUsageDescription</key>
<string>LehrerAgent verbindet sich mit dem OpenClaw-Assistenten auf deinem Mac im lokalen WLAN.</string>

<!--
REQUIRED: Bonjour-Services (für automatische Mac-Erkennung, optional)
Kann weggelassen werden wenn IP manuell eingegeben wird.
-->
<key>NSBonjourServices</key>
<array>
    <string>_openclaw._tcp</string>
</array>

<!--
OPTIONAL: App Transport Security
Nur nötig wenn OpenClaw kein HTTPS/WSS verwendet (lokales WS ist HTTP/WS).
Nur für die lokale IP freigeben, nicht global!
-->
<key>NSAppTransportSecurity</key>
<dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <!--
    Für spezifische IPs (sicherer als NSAllowsArbitraryLoads):
    <key>NSExceptionDomains</key>
    <dict>
        <key>192.168.1.42</key>
        <dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key>
            <true/>
        </dict>
    </dict>
    -->
</dict>
